FROM python:3.11-slim

WORKDIR /app

# Install system build dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir \
    "dnspython>=2.4" \
    "fastapi>=0.110.0" \
    "uvicorn>=0.28.0" \
    "sqlalchemy>=2.0" \
    "asyncpg>=0.29.0" \
    "aiosqlite>=0.20.0" \
    "pydantic>=2.6.0" \
    "pydantic-settings>=2.2.0" \
    "alembic>=1.13.0" \
    "httpx>=0.27.0"

COPY src/ ./src/
COPY alembic.ini .
COPY migrations/ ./migrations/

ENV PYTHONPATH=/app/src

EXPOSE 8000

CMD ["uvicorn", "securedns.monitoring.app:app", "--host", "0.0.0.0", "--port", "8000"]
